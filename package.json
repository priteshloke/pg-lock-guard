{
  "name": "pg-lock-guard",
  "version": "1.0.0",
  "description": "Zero-downtime PostgreSQL migration linter & lock detector that catches AccessExclusiveLock outages before CI deploys to production.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pg-lock-guard": "bin/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "tsx --test src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsx src/cli.ts fixtures/unsafe-migration.sql --suggest-diff"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "migration",
    "linter",
    "zero-downtime",
    "pgbouncer",
    "lock",
    "access-exclusive-lock",
    "ddl",
    "ci-cd",
    "dba"
  ],
  "author": "Pritesh Loke",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
